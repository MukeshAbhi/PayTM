{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "db:generate": {
      "cache": false,
      "outputs": ["src/generated/prisma/**", "node_modules/.prisma/**"]
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "dist/**", "build/**", "!**/.next/cache/**","node_modules/.prisma/**",
                  "node_modules/@prisma/client/**",
                  "src/generated/**"],
      "env": [
        "DATABASE_URL",
        "BANK_WEBHOOK_URL",
        "HMAC_KEY",
        "NEXTAUTH_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "AUTH_RESEND_KEY",
        "NEXTAUTH_URL",
        "NODE_ENV",
        "PRISMA_CLI_BINARY_TARGETS"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["^db:generate"],
      "cache": false,
      "persistent": true
    }
  },
  "globalDependencies": []
}
